# Copy to .env and fill in. Never commit .env.
RAG_ENV=dev
RAG_JWT_SECRET=change-me-to-a-long-random-string

RAG_QDRANT_URL=http://localhost:6333
RAG_REDIS_URL=redis://localhost:6379/0
RAG_QDRANT_COLLECTION=kb_chunks

# Embeddings: "bge-m3" (needs `pip install -e ".[embed]"`, ~2.3 GB model download on first
# use) or "fake" (deterministic hashing, no model; for smoke tests only).
RAG_EMBEDDER=bge-m3
# RAG_EMBED_DEVICE=cuda:0
# RAG_EMBED_USE_FP16=true

# Provider keys (names referenced by configs/models.yaml -> providers.*.api_key_env).
# The default configs/models.yaml routes every model through OpenRouter, so only
# RAG_OPENROUTER_API_KEY is needed; the others are for direct provider access.
RAG_OPENROUTER_API_KEY=
RAG_ANTHROPIC_API_KEY=
RAG_DASHSCOPE_API_KEY=
RAG_OPENAI_API_KEY=
# Optional base_url override per provider name in configs/models.yaml (JSON), e.g. the
# DashScope international endpoint:
# RAG_PROVIDER_BASE_URLS={"dashscope": "https://dashscope-intl.aliyuncs.com/compatible-mode/v1"}
RAG_RERANK_API_KEY=

# Optional M2 tuning (defaults shown)
# RAG_REWRITE_MIN_WORDS=4          # single-turn queries shorter than this are rewritten
# RAG_REWRITE_TIMEOUT_S=6.0        # rewrite gives up and uses the raw query after this
# RAG_INDEX_VERSION_CACHE_TTL_S=5  # how fast a re-ingest invalidates cached answers
