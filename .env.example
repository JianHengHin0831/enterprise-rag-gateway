# Copy to .env and fill in. Never commit .env.
RAG_ENV=dev
RAG_JWT_SECRET=change-me-to-a-long-random-string

RAG_QDRANT_URL=http://localhost:6333
RAG_REDIS_URL=redis://localhost:6379/0

# Provider keys (names referenced by configs/models.yaml -> providers.*.api_key_env)
RAG_ANTHROPIC_API_KEY=
RAG_DASHSCOPE_API_KEY=
RAG_RERANK_API_KEY=
